# NextGen Revenue Insights - Configuration Template
# =================================================
# Copy this file to config/.env and update with your actual values

# Database Configuration
DATABASE_HOST=az-psdb-eastus.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=finance_insights_db
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_SSL=require

# Embedding Configuration
# Choose: 'bge' for open source BGE embeddings or 'azure' for Azure OpenAI
EMBEDDING_PROVIDER=bge

# BGE Configuration (if using BGE)
BGE_MODEL=BAAI/bge-base-en

# Azure OpenAI Configuration (if using Azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key
AZURE_OPENAI_DEPLOYMENT=text-embedding-ada-002
