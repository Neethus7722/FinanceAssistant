# Frontend Environment Configuration Example
# NextGen Revenue Insights Assistant - Frontend
# Copy this file to .env and update with your actual values

# ===========================================
# STREAMLIT APPLICATION CONFIGURATION
# ===========================================
APP_NAME=NextGen Revenue Insights Portal
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8500
DEBUG=false

# ===========================================
# BACKEND API CONFIGURATION
# ===========================================
BACKEND_URL=http://localhost:8001
BACKEND_API_PREFIX=/api
BACKEND_TIMEOUT=30
BACKEND_RETRY_ATTEMPTS=3

# ===========================================
# STREAMLIT CONFIGURATION
# ===========================================
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8500
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_FILE_WATCHER_TYPE=auto
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# ===========================================
# STREAMLIT THEME CONFIGURATION
# ===========================================
STREAMLIT_THEME_PRIMARY_COLOR=#1f77b4
STREAMLIT_THEME_BACKGROUND_COLOR=#ffffff
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#f0f2f6
STREAMLIT_THEME_TEXT_COLOR=#262730

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================
AUTH_ENABLED=false
AUTH_SECRET_KEY=your-frontend-auth-secret-key
AUTH_COOKIE_NAME=finance_assistant_auth
AUTH_COOKIE_EXPIRY_DAYS=7

# ===========================================
# AZURE AUTHENTICATION (Optional)
# ===========================================
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_REDIRECT_URI=http://localhost:8500/auth/callback

# ===========================================
# CHART AND VISUALIZATION CONFIGURATION
# ===========================================
CHART_HEIGHT=400
CHART_WIDTH=800
CHART_THEME=plotly_white
CHART_COLOR_PALETTE=["#1f77b4","#ff7f0e","#2ca02c","#d62728","#9467bd"]

# ===========================================
# CACHE CONFIGURATION
# ===========================================
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100
ENABLE_DATA_CACHING=true

# ===========================================
# UI CONFIGURATION
# ===========================================
SIDEBAR_DEFAULT_STATE=expanded
PAGE_LAYOUT=wide
SHOW_FOOTER=true
SHOW_MENU=true
ENABLE_DARK_MODE=false

# ===========================================
# API CALL CONFIGURATION
# ===========================================
MAX_RETRIES=3
RETRY_DELAY=1
REQUEST_TIMEOUT=30

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_FILE=logs/frontend.log

# ===========================================
# ENVIRONMENT SETTINGS
# ===========================================
ENVIRONMENT=development
